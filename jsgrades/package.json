{
    "name": "jsgrades",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "test": "jest --passWithNoTests --json --outputFile=test-results.json",
        "test:api": "jest --testPathPattern=tests/api --coverage",
        "test:client": "jest --testPathPattern=tests/client --coverage",
        "test:watch": "jest --watch",
        "test:api:watch": "jest --testPathPattern=tests/api --watch",
        "clean": "rm -rf node_modules package-lock.json && npm install ",
