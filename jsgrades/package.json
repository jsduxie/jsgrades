        "@types/react-dom": "^18.2.19",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-config-next": "15.4.7",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^30.1.3",
        "postcss": "^8.4.35",
        "prettier": "^3.2.5",
